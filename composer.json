{
    "name": "asignua/filament-chat",
    "description": "Internal team chat for Filament panels: direct messages, groups, reactions, read receipts, a slide-over dock and links to your panel records.",
    "keywords": ["filament", "filament-plugin", "laravel", "livewire", "chat", "messenger", "team-chat", "reverb"],
    "homepage": "https://github.com/asignua/filament-chat",
    "support": {
        "issues": "https://github.com/asignua/filament-chat/issues",
        "source": "https://github.com/asignua/filament-chat"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Maksym Hladchenko",
            "email": "m2niac@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentChat\\": "src/",
            "Asignua\\FilamentChat\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentChat\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "build:css": "npm run build"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentChat\\FilamentChatServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
